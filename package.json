{
  "name": "emu8086web",
  "version": "1.3.0",
  "private": false,
  "description": "Modern browser-based 8086 assembler and step debugger for every platform",
  "author": "Nafis Islam Kabbo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nafiskabbo/emu_8086_web.git"
  },
  "bugs": {
    "url": "https://github.com/nafiskabbo/emu_8086_web/issues"
  },
  "homepage": "https://github.com/nafiskabbo/emu_8086_web#readme",
  "keywords": [
    "8086",
    "emulator",
    "assembler",
    "masm",
    "assembly",
    "emu8086",
    "education",
    "nextjs"
  ],
  "packageManager": "bun@1.4.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "bun run typecheck && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "bun ./node_modules/typescript-7/bin/tsc --noEmit",
    "test": "bun test lib electron",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "bun run build && node scripts/prepare-electron.mjs",
    "electron:dist:mac": "bun run electron:build && electron-builder --mac dmg --publish never",
    "electron:dist:mac-all": "bun run electron:build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "electron:publish:mac": "bun run electron:build && electron-builder --mac dmg zip --arm64 --x64 --publish always",
    "dist:mac": "bun run electron:dist:mac",
    "prepare": "husky",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "@vercel/analytics": "^2.0.1",
    "electron-updater": "^6.8.9",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "trustedDependencies": ["unrs-resolver"],
  "build": {
    "appId": "com.nafiskabbo.emu8086web",
    "productName": "emu8086web",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "package.json",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "icon.icns",
      "target": ["dmg", "zip"]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nafiskabbo",
        "repo": "emu_8086_web"
      }
    ]
  }
}
